{
  "version": 2,
  "builds": [
    { "src": "api/matches.js", "use": "@vercel/node" },
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "css/**", "use": "@vercel/static" },
    { "src": "js/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/matches", "dest": "/api/matches.js" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
